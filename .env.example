# Copie para .env e preencha somente as chaves dos providers que for usar.

# Anthropic Claude (provider: claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (provider: openai)
# OPENAI_API_KEY=sk-...

# Ollama (provider: ollama) — sem chave; requer Ollama local rodando.

# Observabilidade Langfuse — opt-in. Sem essas três, agentes rodam idênticos
# mas sem tracing. Com elas, todo invoke emite spans para o projeto Langfuse.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
